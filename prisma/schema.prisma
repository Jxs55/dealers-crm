// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dealers   Dealer[] @relation("DealerCreatedBy")
  messageTemplates MessageTemplate[]
  contactedDealers Dealer[] @relation("DealerContactedBy")
  dealerContactAudits DealerContactAudit[]
}

model Dealer {
  id           String   @id @default(cuid())
  name         String
  businessType String
  phone        String?
  instagram    String?
  contactMethod String  @default("none") @map("contact_method")
  location     String
  companyType  String
  contacted    Boolean  @default(false)
  contactedAt  DateTime? @map("contacted_at")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String
  createdBy    User     @relation("DealerCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  contactedById String? @map("contacted_by_id")
  contactedBy  User?    @relation("DealerContactedBy", fields: [contactedById], references: [id], onDelete: SetNull)
  contactAudits DealerContactAudit[]

  @@unique([phone])
  @@unique([instagram])
}

model DealerContactAudit {
  id                 String   @id @default(cuid())
  dealerId           String
  dealer             Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  previousContacted  Boolean?
  nextContacted      Boolean?
  previousContactedAt DateTime?
  nextContactedAt    DateTime?
  createdAt          DateTime @default(now())
  createdById        String
  createdBy          User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([dealerId, createdAt])
}

model MessageTemplate {
  id              String   @id @default(cuid())
  name            String
  messageTemplate String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([name])
}
